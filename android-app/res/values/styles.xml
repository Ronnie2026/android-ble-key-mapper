<resources>
    <style name="YijiaTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#536CC4</item>
        <item name="android:alertDialogTheme">@style/YijiaDialog</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="YijiaDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:colorAccent">#536CC4</item>
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
    </style>
</resources>
